# The VBA editor's File > Import expects CRLF line endings.
*.bas  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cs   text eol=crlf
*.cmd  text eol=crlf
*.md   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Built macro, images and the test drawing: never touch.
*.swp binary
*.png binary
*.pdf binary
