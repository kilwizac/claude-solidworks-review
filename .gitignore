# SolidWorks macro binaries (built locally by importing src/*.bas in the VBA IDE)
*.swp
*.swb

# SolidWorks lock/temp files
~$*
*.~lock*

# Test artifacts
*.SLDDRW
*.SLDPRT
*.SLDASM
*.pdf

# Release builds (tools/make-release.ps1)
dist/

# Tests (tests/Run-Tests.ps1)
tests/.out/
tests/.tools/
tests/browser/node_modules/
tests/browser/test-results/
tests/browser/playwright-report/
.playwright-mcp/
# The demo drawing's PDF is a test fixture.
!tests/fixtures/**/*.pdf
